# ─────────────────────────────────────────────────────────────────────────────
# Findora — configuration.  Copy this file to ".env" and fill in at least ONE
# LLM key (the app needs a language model to run).
#     macOS / Linux:   cp .env.example .env
#     Windows:         copy .env.example .env
# Then open .env and paste your key.  Nothing else is required to run.
# ─────────────────────────────────────────────────────────────────────────────

# Which LLM provider to use:  openrouter (default) | openai | anthropic | ollama
LLM_PROVIDER=openrouter

# ── OpenRouter (default) — one key works with many models.
#    Get a key (free signup): https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional: list several models to compare from the UI picker (comma-separated):
# OPENROUTER_MODELS=openai/gpt-4o-mini,anthropic/claude-3.5-sonnet

# ── OpenAI (use if you set LLM_PROVIDER=openai) — https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ── Anthropic (use if you set LLM_PROVIDER=anthropic) — https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── Local models via Ollama (optional; LLM_PROVIDER=ollama) — https://ollama.com
# OLLAMA_BASE_URL=http://localhost:11434

# ── Engine (optional):  agent (default; hybrid tool-calling agent) | pipeline (v1 fallback)
# ENGINE=agent

# ── LangSmith request tracing (optional; free for students) — https://smith.langchain.com
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=findora
